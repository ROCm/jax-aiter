#
# Paged-KV FFI shims. Build with:
#
#     make -f Makefile.kv ja_kv GFX=gfx942
#
# These rules live outside the main Makefile on purpose. ci/jit_libs_manifest.py
# hashes the Makefile and all of csrc/common as inputs that "can change the JIT
# library bytes", and that hash keys the immutable release holding the multi-GB
# MHA libraries. Adding KV targets there would invalidate those binaries on every
# paged-KV change even though none of it reaches their build: build_jit.py
# compiles only aiter and CK sources, and these shims are separate .so files that
# link nothing from the JIT libraries.
#
# Keeping them here means a paged-KV change costs no JIT rebuild. It follows the
# same reasoning already applied to scripts/*.patch, which were removed from the
# hash for invalidating MHA binaries they never fed.
#
# Everything shared -- HIPCC, arch flags, include roots, the build directory --
# comes from the main Makefile.

include Makefile

# The M0 aliasing probe deliberately carries no aiter dependency, so it builds
# and runs before third_party/aiter is populated.
KV_PROBE_INCLUDES := -I$(JAX_FFI_INC) -I$(PYTHON_INC) -I$(JAX_AITER_INC)

# append_kv and paged attention compile aiter sources directly rather than
# linking a JIT library, so they need aiter's own include tree.
#
# AITER_NO_TORCH_TYPES is aiter's own opt-out for the c10 include in
# aiter_opus_plus.h, which exists only for the t2opus mapping of torch scalar
# types. Nothing on the aiter_tensor_t path needs it, so these shims build with
# no PyTorch headers at all.
KV_DEFINES  := -DAITER_NO_TORCH_TYPES
KV_INCLUDES := $(KV_PROBE_INCLUDES) $(KV_DEFINES) \
               -I$(AITER_SRC_DIR)/csrc/include \
               -I$(AITER_SRC_DIR)/csrc/include/ck_tile \
               -I$(AITER_SRC_DIR)/3rdparty/composable_kernel/include

# Paged attention binds the prebuilt kernel by dlopen rather than linking
# aiter's cpp_itfs dispatch layer, so it needs nothing beyond libdl: no fmt, no
# openssl, and no aiter sources compiled in. See the comment at the top of
# csrc/ffi/kv/paged_attention_ja.cu for why the dispatch layer is unusable.
PA_INCLUDES := $(KV_PROBE_INCLUDES)
PA_LDFLAGS  := -ldl

JA_KV_PROBE_MODULES := $(JA_BUILD_DIR)/kv_alias_probe_ja.so

JA_KV_MODULES := $(JA_KV_PROBE_MODULES) \
                 $(JA_BUILD_DIR)/append_kv_ja.so \
                 $(JA_BUILD_DIR)/paged_attention_ja.so

.PHONY: ja_kv ja_kv_probe

# Paged-KV shims: probe plus append_kv (M1) and paged attention (M2).
ja_kv: $(JA_KV_MODULES)

# M0 only: the aliasing probe, buildable with no aiter sources present.
ja_kv_probe: $(JA_KV_PROBE_MODULES)

$(JA_BUILD_DIR)/kv_alias_probe_ja.so: csrc/ffi/kv/kv_alias_probe_ja.cu | $(JA_BUILD_DIR)/
	$(HIPCC) -shared -fPIC $(JA_CXXFLAGS) $(AMDGPU_TARGET_FLAGS) $(KV_PROBE_INCLUDES) $< -o $@

# Compiles aiter's cache kernels into the module, so append_kv needs no JIT lib.
$(JA_BUILD_DIR)/append_kv_ja.so: csrc/ffi/kv/append_kv_ja.cu \
                                 $(AITER_SRC_DIR)/csrc/kernels/cache_kernels.cu | $(JA_BUILD_DIR)/
	$(HIPCC) -shared -fPIC $(JA_CXXFLAGS) $(AMDGPU_TARGET_FLAGS) $(KV_INCLUDES) \
		csrc/ffi/kv/append_kv_ja.cu $(AITER_SRC_DIR)/csrc/kernels/cache_kernels.cu -o $@

# The kernel itself is compiled ahead of time and resolved by dlopen at run
# time; see scripts/prebuild_pa_ragged.py.
$(JA_BUILD_DIR)/paged_attention_ja.so: csrc/ffi/kv/paged_attention_ja.cu | $(JA_BUILD_DIR)/
	$(HIPCC) -shared -fPIC $(JA_CXXFLAGS) $(AMDGPU_TARGET_FLAGS) $(PA_INCLUDES) \
		$< $(PA_LDFLAGS) -o $@

# `include Makefile` above would otherwise make its `all` target the default.
.DEFAULT_GOAL := ja_kv

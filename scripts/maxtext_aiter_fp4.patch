index 0000000000000000000000000000000000000000..1e425c503b3a4f95bbbf86327251b5f29290fb83
--- /dev/null
+++ b/src/maxtext/common/mlperf_logger.py
@@ -0,0 +1,162 @@
+# Copyright 2026 Google LLC

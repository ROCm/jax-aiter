+  db = jax.lax.dot_general(g, a_bf16, (((0,), (0,)), ((), ()))).astype(jnp.bfloat16)
+
+  # Return updated scale/history as "gradients" — the optimizer overwrites
+  # _overwrite_with_gradient variables with these values

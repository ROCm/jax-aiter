# SPDX-License-Identifier: MIT
# First-party FlyDSL-to-JAX bridge. This build is intentionally independent of
# third_party/aiter and never builds jaxlib.

PYTHON3 ?= python3
HIPCC ?= /usr/local/bin/hipcc

JAX_FFI_INC := $(shell $(PYTHON3) -c 'from jax import ffi; print(ffi.include_dir())')
OUT_DIR := build/jax_aiter_build
BRIDGE_SO := $(OUT_DIR)/flydsl_bridge_ja.so
BRIDGE_SRC := csrc/ffi/flydsl/flydsl_bridge_ja.cc

CXXFLAGS := -std=c++20 -shared -fPIC -O3 \
	-DUSE_ROCM -D__HIP_PLATFORM_AMD__ \
	-I$(JAX_FFI_INC) -fvisibility-inlines-hidden -fvisibility=hidden
LDFLAGS := -lamdhip64 -pthread

.PHONY: all bridge clean-flydsl

all: bridge

bridge: $(BRIDGE_SO)

$(OUT_DIR):
	mkdir -p $@

$(BRIDGE_SO): $(BRIDGE_SRC) | $(OUT_DIR)
	$(HIPCC) $(CXXFLAGS) $< $(LDFLAGS) -o $@

clean-flydsl:
	rm -f $(BRIDGE_SO)

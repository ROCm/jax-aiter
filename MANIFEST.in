# Include compiled libraries in source distribution
recursive-include jax_aiter/_lib *.so

# Include HSA kernel files
recursive-include jax_aiter/_hsa *.co
recursive-include jax_aiter/_hsa *.csv
recursive-include jax_aiter/_hsa *.py

# The license-gated MXFP4 MoE kernels are unused and must never ship, even
# from a local copy in the source tree.
prune jax_aiter/flydsl/kernels/mxfp4

# Include README and license
include README.md
include LICENSE
